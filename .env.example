# Local mode only. Your PayRam URL: same origin as the dashboard (no :8080)
PAYRAM_BASE_URL=https://pay.example.com

# Payram API key (see dashboard)
PAYRAM_API_KEY=replace_me

# Dashboard login tokens (POST /api/v1/signin, or ~/.payraminfo/headless-tokens.env on an agent install).
# Required for the local data tools. Never set these on a shared/hosted deployment.
PAYRAM_ACCESS_TOKEN=
PAYRAM_REFRESH_TOKEN=

# Default external platform ID (optional, can override per tool call)
PAYRAM_EXTERNAL_PLATFORM_ID=

# Port for the MCP HTTP server (optional, default: 3333)
PORT=3333

# Where this MCP runs. "local" (default off Vercel) binds 127.0.0.1 and may use the credentials above.
PAYRAM_MCP_MODE=local
# Non-loopback binds: set HOST, the accepted Host names, and a bearer token clients must send.
# HOST=0.0.0.0
# MCP_ALLOWED_HOSTS=mcp.internal.example
# MCP_SERVER_TOKEN=change-me
