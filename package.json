{
  "name": "payram-mcp-server",
  "version": "1.2.0",
  "private": true,
  "mcpName": "com.payram/mcp",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:ngrok": "ngrok http 3333 --log=stdout",
    "prebuild": "node scripts/build-skills-index.mjs && node scripts/generate-build-info.mjs",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "skills:build": "node scripts/build-skills-index.mjs",
    "test": "vitest run",
    "predev": "node scripts/generate-build-info.mjs",
    "pretest": "node scripts/generate-build-info.mjs",
    "build-info": "node scripts/generate-build-info.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "skills": [
    "./skills/compare-crypto-payments",
    "./skills/payram-agent-journey",
    "./skills/payram-agent-onboarding",
    "./skills/payram-analytics",
    "./skills/payram-auth",
    "./skills/payram-bitcoin-payments",
    "./skills/payram-checkout-integration",
    "./skills/payram-crypto-payments",
    "./skills/payram-no-kyc-crypto-payments",
    "./skills/payram-openclaw-integration",
    "./skills/payram-payment-integration",
    "./skills/payram-payouts",
    "./skills/payram-self-hosted-payment-gateway",
    "./skills/payram-setup",
    "./skills/payram-stablecoin-payments",
    "./skills/payram-testnet-testing",
    "./skills/payram-topup-wallet-integration",
    "./skills/payram-webhook-integration",
    "./skills/payram-widget-integration"
  ],
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "@types/supertest": "^7.2.1",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "payram": "^1.0.1",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "turndown": "^7.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8",
    "vitest": "^5.0.1"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.12"
  }
}
